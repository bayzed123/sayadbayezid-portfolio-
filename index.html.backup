        "thumbnailUrl": "https://i.postimg.cc/8zs6Nvj1/27029CEE-5CD8-43AE-85D0-51C18A4BF0C8-Original.png",
        "datePublished": "2026-05-04",
        "dateModified": "2026-05-04",
        "author": {"@id": "https://sayadbayezid.com#person"},
        "creator": {"@id": "https://sayadbayezid.com#person"},
        "inLanguage": "en",
        "isAccessibleForFree": true,
        "mainEntity": {"@id": "https://sayadbayezid.com#person"}
      },
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://sayadbayezid.com#website",
        "url": "https://sayadbayezid.com",
        "name": "Sayad md Bayezid Hosan Portfolio",
        "description": "Official portfolio and digital hub of Sayad md Bayezid Hosan",
        "mainEntity": {"@id": "https://sayadbayezid.com#person"}
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://sayadbayezid.com"
          },
          {
