{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bayezid-agency-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },

  // Public — same value already visible in the Pixel base code on the site.
